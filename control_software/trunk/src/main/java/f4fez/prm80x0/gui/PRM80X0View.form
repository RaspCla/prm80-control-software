            <MenuItem class="javax.swing.JMenuItem" name="configurationMenuItem">
              <Properties>
                <Property name="text" type="java.lang.String" value="Configuration ..."/>
                <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Settings stored in the &lt;b&gt;PRM80&lt;/b&gt; (its RAM): PLL step, default shift,&lt;br&gt;squelch and the scan speed of the scan of the radio (key at the radio).&lt;br&gt;Read / write from / to the PRM80, save in a file (*.cfg).&lt;/html&gt;"/>
                <Property name="enabled" type="boolean" value="false"/>
                <Property name="name" type="java.lang.String" value="configurationMenuItem" noResource="true"/>
              </Properties>
              <Events>
                <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="configurationMenuItemActionPerformed"/>
              </Events>
            </MenuItem>
            <Menu class="javax.swing.JMenu" name="memoryMenu">
              <Properties>
                <Property name="text" type="java.lang.String" value="Memory"/>
                <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;The PRM80 works with the channels and settings in its &lt;b&gt;RAM&lt;/b&gt;.&lt;br&gt;The RAM keeps them for some weeks without power.&lt;br&gt;The &lt;b&gt;EEPROM&lt;/b&gt; holds a permanent copy, loaded when the RAM content is lost.&lt;/html&gt;"/>
                <Property name="enabled" type="boolean" value="false"/>
                <Property name="name" type="java.lang.String" value="memoryMenu" noResource="true"/>
              </Properties>
              <SubComponents>
                <MenuItem class="javax.swing.JMenuItem" name="ramIntMenuItem">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="RAM intern 80c552"/>
                    <Property name="name" type="java.lang.String" value="ramIntMenuItem" noResource="true"/>
                  </Properties>
                </MenuItem>
                <MenuItem class="javax.swing.JMenuItem" name="ramExtMenuItem">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="RAM extern"/>
                    <Property name="name" type="java.lang.String" value="ramExtMenuItem" noResource="true"/>
                  </Properties>
                </MenuItem>
                <MenuItem class="javax.swing.JMenuItem" name="eepromMenuItem">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="EEPROM"/>
                    <Property name="name" type="java.lang.String" value="eepromMenuItem" noResource="true"/>
                  </Properties>
                </MenuItem>
                <MenuItem class="javax.swing.JMenuItem" name="ram2eepromMenuItem">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="Copy RAM -&gt; EEPROM (save permanently) ..."/>
                    <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Copy the whole RAM to the EEPROM, so that it is kept permanently:&lt;br&gt;all channels &lt;b&gt;and&lt;/b&gt; all settings (PLL step, default shift, scan speed,&lt;br&gt;squelch, mode, current channel), not only the channel list.&lt;br&gt;The previous content of the EEPROM is overwritten.&lt;/html&gt;"/>
                    <Property name="name" type="java.lang.String" value="ram2eepromMenuItem" noResource="true"/>
                  </Properties>
                  <Events>
                    <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="ram2eepromMenuItemActionPerformed"/>
                  </Events>
                </MenuItem>
                <MenuItem class="javax.swing.JMenuItem" name="eeprom2ramMenuItem">
                  <Properties>
                    <Property name="text" type="java.lang.String" value="Copy EEPROM -&gt; RAM (restore) ..."/>
                    <Property name="toolTipText" type="java.lang.String" value="&lt;html&gt;Replace the RAM with the copy in the EEPROM:&lt;br&gt;all channels &lt;b&gt;and&lt;/b&gt; all settings in the RAM are overwritten.&lt;br&gt;Save the channel list and the configuration in files first&lt;br&gt;if you may need the current state again.&lt;/html&gt;"/>
                    <Property name="name" type="java.lang.String" value="eeprom2ramMenuItem" noResource="true"/>
                  </Properties>
                  <Events>
                    <EventHandler event="actionPerformed" listener="java.awt.event.ActionListener" parameters="java.awt.event.ActionEvent" handler="eeprom2ramMenuItemActionPerformed"/>
                  </Events>
                </MenuItem>
              </SubComponents>
            </Menu>
